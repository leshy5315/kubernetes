apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: myingress
spec:
  ingressClassName: traefik
  tls:
  - hosts:
    - lesyk.d1ma-angel.com
    secretName: lesyk-tls
  rules:
  - host: lesyk.d1ma-angel.com
    http:
      paths:
      - pathType: Prefix
        path: /
        backend:
          service:
            name: nginx-autoscale
            port:
              number: 80
  