apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ingress-hosts
  annotations:
    kubernetes.io/ingress.class: nginx
spec:
  ingressClassName: nginx
  rules:
  - host: lesyk.d1ma-angel.com
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: nginx-autoscale
            port:
              number: 80
