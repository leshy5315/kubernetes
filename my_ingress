apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: myingress
  anotations:
    cert-manager.io/cluster-issuer: "letsencrypt-staging"
spec:
  tls:
  - hosts:
    - lesyk.d1ma-angel.com
  ingressClassName: traefik
  rules:
  - http:
      paths:
      - pathType: Prefix
        path: /
        backend:
          service:
            name: nginx-autoscale
            port:
              number: 80
