apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: lesyk-ingress
  namespace: ssl-web
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
    traefik.ingress.kubernetes.io/router.middlewares: ssl-web-block-ip@kubernetescrd
spec:
  ingressClassName: traefik
  tls:
  - hosts:
    - lesyk.d1ma-angel.com
    secretName: app-tls
  rules:
  - host: lesyk.d1ma-angel.com
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: myapp
            port:
              number: 80
