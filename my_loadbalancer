apiVersion: v1
kind: Service
metadata:
  name: myapp
  labels:
    env  : prod
    owner: Lesyk
spec:
  selector:
    app: nginx          # Selecting PODS those Labels
  ports:
    - name      : app-listener
      protocol  : TCP
      port      : 80    #Port on load Balancer
      targetPort: 80    #Port on Pod
      nodePort  : 30080
  type: LoadBalancer