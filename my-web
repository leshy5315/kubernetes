apiVersion: v1
kind: apiVersion: apps/v1
kind: Deployment
metadata:
  name: myapp
spec:
  selector:
    matchLabels:
      app: myapp
  template:
    metadata:
      labels:
        app: myapp
    spec:
      containers:
      - name: myapp
        image: nginx
        resources:
        ports:
        - containerPort: 80
        - name: myapp
        image: certbot/certbot:nightly
