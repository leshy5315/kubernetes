apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-deployment
  labels:
    app : nginx
    serv: certbot
spec:
  replicas: 3
  selector:
    matchLabels:
      app: nginx
  template:
    metadata:
      labels:
        app : nginx
        serv: certbot
    spec:
      containers:
      - name : nginx
        image: nginx:1.14.2
        ports:
        - containerPort: 80
        containers:
      - name : certbot
        image: certbot/certbot:nightly
    
      
